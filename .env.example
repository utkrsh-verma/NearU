# Supabase Configuration
# VITE_SUPABASE_URL: Project URL from your Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Client-side anon / public API key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret service role key (keep secure, never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Supabase PostgreSQL direct connection)
# Can be provided via DATABASE_URL or individual SQL_* variables
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SQL_HOST="db.[YOUR-PROJECT-REF].supabase.co"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_POSTGRES_PASSWORD"
SQL_DB_NAME="postgres"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NearU Campus Eligibility Configuration (comma-separated allowed institutional domains)
ALLOWED_COLLEGE_DOMAINS="glbitm.ac.in"

# Optional campus verification invite code for students using personal Google accounts
# alongside their institutional @glbitm.ac.in verification email
CAMPUS_ACCESS_CODE="GLB-CAMPUS-2026"

# Secret used to sign private photo URLs
PHOTO_SIGNING_SECRET="change-me-in-production"
