# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NearU Campus Eligibility Configuration (comma-separated allowed institutional domains)
ALLOWED_COLLEGE_DOMAINS="glbitm.ac.in"

# Optional campus verification invite code for students using personal Google accounts
# alongside their institutional @glbitm.ac.in verification email
CAMPUS_ACCESS_CODE="GLB-CAMPUS-2026"

# Secret used to sign private photo URLs
PHOTO_SIGNING_SECRET="change-me-in-production"
